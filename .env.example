# Copy this file to .env.local and add the values from your Supabase project.
# These two values are public client credentials and are safe to expose only when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
